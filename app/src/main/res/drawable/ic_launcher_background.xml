<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon BACKGROUND layer — a flat fill, no art.

  Green50 (#EEF8F2, the nv-green-50 token in design/theme/Color.kt) is the brand's own
  soft wash: it keeps the white-ish mint read of the logo plate while staying
  light enough that the dark-green body faces of the cube below still separate
  at 48dp. A white plate was rejected: on a white launcher wall the icon
  becomes a floating cube with no plate identity.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#EEF8F2"
        android:pathData="M0,0h108v108h-108z" />
</vector>
